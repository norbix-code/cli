{
  "name": "@norbix.ai/cli",
  "version": "0.1.0",
  "description": "Norbix CLI — manage your Norbix projects from the terminal. Built on the official TypeScript SDK.",
  "author": "UAB Isidos",
  "license": "MIT",
  "homepage": "https://norbix.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norbix-code/cli.git"
  },
  "bugs": {
    "url": "https://github.com/norbix-code/cli/issues"
  },
  "keywords": [
    "norbix",
    "cli",
    "baas",
    "backend",
    "database",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "norbix": "./bin/run.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node -e \"require('node:fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node ./bin/run.js",
    "prepack": "npm run build && oclif manifest",
    "postpack": "node -e \"require('node:fs').rmSync('oclif.manifest.json',{force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build",
    "gen:fields": "node scripts/gen-request-fields.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@norbix.ai/ts": "^4.4.0",
    "@oclif/core": "^5.0.0",
    "@oclif/plugin-autocomplete": "^4.0.0",
    "@oclif/plugin-help": "^7.0.0"
  },
  "devDependencies": {
    "@oclif/test": "^5.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "oclif": "^6.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "oclif": {
    "bin": "norbix",
    "dirname": "norbix",
    "commands": "./dist/commands",
    "helpClass": "./dist/help.js",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ],
    "topics": {
      "account": {
        "description": "Account profile, projects, team, usage, billing"
      },
      "ai": {
        "description": "LLM and MCP server integrations, AI service users",
        "subtopics": {
          "llm": {
            "description": "Create, test, turn on/off and delete an LLM integration"
          },
          "mcp": {
            "description": "Create, test, turn on/off and delete an MCP server integration"
          },
          "service-user": {
            "description": "Create and delete AI service users, rotate and revoke their keys"
          }
        }
      },
      "apikeys": {
        "description": "Show or regenerate project API keys"
      },
      "email": {
        "description": "Email module, integrations, footers, signatures, templates and campaigns",
        "subtopics": {
          "validation": {
            "description": "Email-validation integrations (check addresses before a campaign sends)"
          }
        }
      },
      "config": {
        "description": "Read and write the local CLI configuration"
      },
      "db": {
        "description": "Work with database collections (find, insert, update, delete)"
      },
      "files": {
        "description": "Upload, download and manage files",
        "subtopics": {
          "integrations": {
            "description": "Check the storage behind a files integration"
          }
        }
      },
      "env": {
        "description": "Manage project environments (PROD, TEST, ...)"
      },
      "logs": {
        "description": "Read project logs"
      },
      "payments": {
        "description": "Payment integrations and triggers"
      },
      "project": {
        "description": "Project settings: name, languages, regions, CORS, admin portal, legal documents, AI chat",
        "subtopics": {
          "cors": {
            "description": "Browser origins allowed to call the project's APIs"
          },
          "admin-portal": {
            "description": "The end-user admin portal Norbix generates for the project"
          },
          "legal": {
            "description": "Terms & Conditions and Privacy Policy (Markdown)"
          },
          "ai": {
            "description": "AI chat settings, assistants and usage",
            "subtopics": {
              "assistant": {
                "description": "Create, change and delete AI assistants"
              },
              "settings": {
                "description": "AI chat on/off, default LLM and model"
              }
            }
          }
        }
      },
      "push": {
        "description": "Push notification templates and campaigns"
      },
      "scheduler": {
        "description": "Manage scheduler tasks"
      },
      "sms": {
        "description": "SMS module, integrations, templates and campaigns"
      },
      "users": {
        "description": "Manage project users (membership)"
      },
      "webhooks": {
        "description": "Inspect the webhook integration and its destinations"
      }
    },
    "hooks": {
      "init": "./dist/hooks/init.js",
      "command_not_found": "./dist/hooks/command-not-found.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
