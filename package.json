{
  "name": "@norbix.ai/cli",
  "version": "0.1.0",
  "description": "Norbix CLI — manage your Norbix projects from the terminal. Built on the official TypeScript SDK.",
  "author": "UAB Isidos",
  "license": "MIT",
  "homepage": "https://norbix.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norbix-code/cli.git"
  },
  "bugs": {
    "url": "https://github.com/norbix-code/cli/issues"
  },
  "keywords": [
    "norbix",
    "cli",
    "baas",
    "backend",
    "database",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "norbix": "./bin/run.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node ./bin/run.js",
    "prepack": "npm run build && oclif manifest",
    "postpack": "node -e \"require('node:fs').rmSync('oclif.manifest.json',{force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@norbix.ai/ts": "^1.2.0",
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-autocomplete": "^3.0.0",
    "@oclif/plugin-help": "^7.0.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.2.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.7.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "oclif": "^4.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "oclif": {
    "bin": "norbix",
    "dirname": "norbix",
    "commands": "./dist/commands",
    "helpClass": "./dist/help.js",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ],
    "topics": {
      "account": {
        "description": "Account profile, projects, team, usage, billing"
      },
      "apikeys": {
        "description": "Show or regenerate project API keys"
      },
      "email": {
        "description": "Email templates and campaigns"
      },
      "config": {
        "description": "Read and write the local CLI configuration"
      },
      "db": {
        "description": "Work with database collections (find, insert, update, delete)"
      },
      "files": {
        "description": "Upload, download and manage files"
      },
      "env": {
        "description": "Manage project environments (PROD, TEST, ...)"
      },
      "logs": {
        "description": "Read project logs"
      },
      "payments": {
        "description": "Payment integrations and triggers"
      },
      "push": {
        "description": "Push notification templates and campaigns"
      },
      "scheduler": {
        "description": "Manage scheduler tasks"
      },
      "sms": {
        "description": "SMS templates and campaigns"
      },
      "users": {
        "description": "Manage project users (membership)"
      },
      "webhooks": {
        "description": "Inspect the webhook integration and its destinations"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
