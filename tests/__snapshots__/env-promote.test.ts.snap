// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`norbix env built-ins repair > previews by default, repairs with --yes, one env with --target 1`] = `
"Preview: built-in templates, footer and signature — nothing was changed.

TEST
  PRESENT (1)
    EmailTemplate    Password reset                   tmpl_6kbXOl8AX1HdVMyFwURznj  [built-in]
  REALIGNED (1)
    EmailFooter      Default                          ftr_1  [built-in]
        takes PROD's id

To apply it: add --yes
"
`;

exports[`norbix env promote > a real run with nothing to change: says nothing was promoted, no rollback anchor, exit 0 1`] = `
"Nothing to promote — PROD already matches TEST.
Summary: 0 added · 0 changed · 2 unchanged · 0 deleted · 0 kept · 0 skipped
Integrations: 0 seeded · 1 skipped · 0 mapped

Content
  UNCHANGED (2)
    Schema faq, EmailTemplate Password reset

Integrations (choice per source integration; ! = sends real e-mail / SMS / push)
    Email      Test Me                        Fake                     skip                 int_test_fake  [fake]
      note: PROD already has its own Fake Email integration
      in target: Test Me (Fake, default) int_prod_fake

"
`;

exports[`norbix env promote > previews by default: sends dryRun true, prints the readable plan, changes nothing, exit 0 1`] = `
"Preview: TEST → PROD — nothing was changed.
Summary: 1 added · 1 changed · 2 unchanged · 1 deleted (1 record at risk) · 0 kept · 0 skipped
Integrations: 1 seeded · 2 skipped · 0 mapped

Content
  ADDED (1)
    Schema           orders                           sch_3jucP9sDknGQ7R4zBwQKc4
  CHANGED (1)
    Schema           faq                              sch_src  [matched by name (was sch_old)]
        matched by name; the collection takes the source id, its records stay
  DELETED (1)
    Schema           legacy_faq                       sch_gone  [1 record]
        collection 'legacy_faq': 1 records would be deleted (they stay in the database and come back if you roll back)
  UNCHANGED (2)
    EmailTemplate Password reset, Taxonomy Shipping status

Integrations (choice per source integration; ! = sends real e-mail / SMS / push)
    Database   TEST database                  MongoDbConnectionString  skip                 int_db  [holds a secret]
      in target: Primary Database (MongoDbConnectionString, default) int_prod_db
  ! Email      mailgun                        MailGun                  skip                 int_mailgun  [REAL SENDER, holds a secret]
      in target: Test Me (Fake, default) int_fake
    Files      S3 files                       AwsS3                    seed (default skip)  int_s3  [holds a secret]
      id in the target: int_s3_prod (its own new id — apps use this id there)

Taxonomy terms: 1 created

Not promoted
  - Users, system users and their API keys (environment): each environment keeps its own users in its own database
  - Roles and policies (project): not environment-scoped — unchanged

A real run hides the records listed under DELETED (they come back on rollback). Add --confirm-record-loss only if that is intended.
To apply it: norbix env promote --from TEST --to PROD --yes --confirm-record-loss
Change an integration choice with --seed <id>, --skip <id> or --map <id>=<target id>.
"
`;

exports[`norbix env rollback > previews by default and runs with --yes 1`] = `
"Preview: rollback of PROD — nothing was changed.
Summary: 0 added · 0 changed · 2 unchanged · 1 deleted (1 record at risk) · 0 kept · 0 skipped
Integrations: 1 seeded · 2 skipped · 0 mapped · 1 removed

Content
  ADDED (1)
    Schema           orders                           sch_3jucP9sDknGQ7R4zBwQKc4
  CHANGED (1)
    Schema           faq                              sch_src  [matched by name (was sch_old)]
        matched by name; the collection takes the source id, its records stay
  DELETED (1)
    Schema           legacy_faq                       sch_gone  [1 record]
        collection 'legacy_faq': 1 records would be deleted (they stay in the database and come back if you roll back)
  UNCHANGED (2)
    EmailTemplate Password reset, Taxonomy Shipping status

Integrations
  ! Email      mailgun                        MailGun                  removed              int_mailgun  [REAL SENDER, holds a secret]

Taxonomy terms: 1 created

Not promoted
  - Users, system users and their API keys (environment): each environment keeps its own users in its own database
  - Roles and policies (project): not environment-scoped — unchanged

A real run hides the records listed under DELETED (they come back on rollback). Add --confirm-record-loss only if that is intended.
To apply it: norbix env rollback --to PROD --version 279 --yes --confirm-record-loss
"
`;
